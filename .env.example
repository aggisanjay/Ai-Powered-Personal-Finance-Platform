# ==============================================================================
# Aura Finance - Environment Configuration Template
# Copy this file to '.env' and populate your local credentials.
# ==============================================================================

# Application Settings
PROJECT_NAME="AI-Powered Personal Finance Platform"
VERSION="1.0.0"
SECRET_KEY="replace_with_a_secure_random_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Remote PostgreSQL (e.g. Neon, Supabase, RDS) or local SQLite:
# DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"
# Local SQLite fallback:
DATABASE_URL="sqlite:///./finance.db"

# Storage Settings
UPLOAD_DIR="./uploads/receipts"
MAX_UPLOAD_SIZE_MB=15

# Optional AI Providers (System is 100% functional deterministically without keys)
# GEMINI_API_KEY="your-google-gemini-api-key"
# OPENAI_API_KEY="your-openai-api-key"
